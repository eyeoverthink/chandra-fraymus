# Chandra-FRAYMUS — copy to .env and fill in your values
# See README for details on each section.

# Persistence: SQLite in DATA_DIR by default; set both to use Supabase (run supabase/schema.sql first)
CHANDRA_DATA_DIR=./data
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# Server
HOST=127.0.0.1
PORT=8787
CHANDRA_PORT=8787
NODE_ENV=development
# Optional workspace overrides for local launcher/static serving
# CHANDRA_PARTNER_DIR=..\MyAIPartner
# CHANDRA_PARTNER_DIST=..\MyAIPartner\dist
# FRAYMUS_VOICE_ENTRY=..\fraymus-voice\bin\local-voice-server.py

# Auth (Clerk). When CLERK_SECRET_KEY is set every /api route needs a signed-in user.
# CLERK_SECRET_KEY=
# VITE_CLERK_PUBLISHABLE_KEY=

# Billing (Stripe metered usage)
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_METER_EVENT_NAME=
# FREE_CREDITS=100

# PUBLIC_URL=https://yourapp.fly.dev
# CORS_ORIGIN=

# LLM Providers
# LLM_PROVIDERS=ollama,groq,openai
OLLAMA_BASE_URL=http://127.0.0.1:11434
FRAYMUS_DEFAULT_MODEL=llama3.2
# F.R.A.Y.M.U.S. voice. Leave the VoiceStudio URL empty to use Piper only.
# FRAYMUS_VOICESTUDIO_URL=http://127.0.0.1:9099
# FRAYMUS_VOICE_ID=vaughn-one
# FRAYMUS_PIPER_MODEL=en_US-lessac-medium
# Set to 1 only when a public Ollama or VoiceStudio host should be contacted.
# FRAYMUS_OS_ALLOW_PUBLIC=0
# GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# YouTube Research / Outlier Board
# YOUTUBE_API_KEY=

# Shopify (Content-to-Commerce Pipeline)
# SHOPIFY_ACCESS_TOKEN=
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Printify (Apparel Pipeline — print-on-demand)
# PRINTIFY_ACCESS_TOKEN=
# PRINTIFY_SHOP_ID=

# Autonomy engine (set 0 to disable)
# FRAYMUS_AUTONOMY_AUTOSTART=1

# MCP
# MCP_SERVERS_FILE=./config/mcp-servers.json
# MCP_ADMIN_TOKEN=

# Media skills (all optional)
# VOICESTUDIO_MCP_URL=
# PHOTOCRAFT_CLI=
# REA_MCP=

# --- Hive (Phase U) ---
# NUDP peers to seed (addr:port, comma-separated). Default: the Raspberry Pi.
# MESH_PEERS=10.0.0.163:47100
# V13 hub write-tier token: point at a file holding ONLY the token (preferred — a
# process-level FRAYMUS_HUB_TOKEN would otherwise shadow .env under `node --env-file`).
# FRAYMUS_HUB_TOKEN_FILE=C:/Users/you/fraymus-hub-token.txt
# fraymus-bridge: pull is on by default; set to 1 to also push Chandra's digests.
# HIVE_BRIDGE_PUSH=0
# FMP/1 node (the Pi's protocol). Auto-enabled when <FMP1_DATA_DIR>/identity.key exists
# (create with `python -m fmp1 --data-dir <dir> keygen`). Set FMP1_ENABLED=0 to disable.
# FMP1_PYTHON=python
# FMP1_DATA_DIR=C:/Users/you/.fmp1
# FMP1_PORT=47100
# FMP1_CONTROL_PORT=47101
# FMP1_PEERS=10.0.0.163:47100
# FMP1_ROSTER=<FMP1_DATA_DIR>/roster.cbor
# FMP1_ROOT_PUB=<hex; default read from <FMP1_DATA_DIR>/root.pub>

# --- Phase V: inference scheduling & anti-thrash ---
# Concurrent Ollama requests admitted by the scheduler (one GPU: 1–2). Low-priority classes
# (forge/debate/verifier/reflection/dream) are dropped after their max wait or when the queue is full.
# OLLAMA_MAX_CONCURRENT=2
# OLLAMA_MAX_QUEUE=24
# Minimum gap between autonomous reflections (manual/API reflections bypass). Default 10 min.
# REFLECTION_MIN_INTERVAL_MS=600000
# Motor region firing floors (ms). Defaults: reflect 10 min, self-audit 10 min, goal-seek 3 min.
# MOTOR_REFLECT_MIN_MS=600000
# MOTOR_SELFAUDIT_MIN_MS=600000
# MOTOR_GOALSEEK_MIN_MS=180000
