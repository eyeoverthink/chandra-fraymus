# Chandra-FRAYMUS — copy to .env and fill in your values
# See README for details on each section.

# Persistence: SQLite in DATA_DIR by default; set both to use Supabase (run supabase/schema.sql first)
CHANDRA_DATA_DIR=./data
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# Server
HOST=127.0.0.1
PORT=8787
NODE_ENV=development

# Auth (Clerk). When CLERK_SECRET_KEY is set every /api route needs a signed-in user.
# CLERK_SECRET_KEY=
# VITE_CLERK_PUBLISHABLE_KEY=

# Billing (Stripe metered usage)
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_METER_EVENT_NAME=
# FREE_CREDITS=100

# PUBLIC_URL=https://yourapp.fly.dev
# CORS_ORIGIN=

# LLM Providers
# LLM_PROVIDERS=ollama,groq,openai
OLLAMA_BASE_URL=http://127.0.0.1:11434
FRAYMUS_DEFAULT_MODEL=llama3.2
# GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# YouTube Research / Outlier Board
# YOUTUBE_API_KEY=

# Shopify (Content-to-Commerce Pipeline)
# SHOPIFY_ACCESS_TOKEN=
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Autonomy engine (set 0 to disable)
# FRAYMUS_AUTONOMY_AUTOSTART=1

# MCP
# MCP_SERVERS_FILE=./config/mcp-servers.json
# MCP_ADMIN_TOKEN=

# Media skills (all optional)
# VOICESTUDIO_MCP_URL=
# PHOTOCRAFT_CLI=
# REA_MCP=
