    /** Recursive descent parser for evolved axiom formulas. */\
    private SymbolicEquation parseAxiom(String f) \{\
        f = f.trim();\
        // Base atoms\
        if (f.equals("tanh(x)")) return new SymbolicEquation("tanh(x)", Math::tanh);\
        if (f.equals("sin(x)"))  return new SymbolicEquation("sin(x)",  Math::sin);\
        if (f.equals("cos(x)"))  return new SymbolicEquation("cos(x)",  Math::cos);\
        if (f.equals("x"))       return new SymbolicEquation("x",       v -> v);\
        if (f.equals("exp(-|x|)")) return new SymbolicEquation("exp(-|x|)", v -> Math.exp(-Math.abs(v)));\
        // Composite: (A * B), (A + B), (A - B)\
        if (f.startsWith("(") && f.endsWith(")")) \{\
            String inner = f.substring(1, f.length() - 1);\
            int split = findBinaryOpSplit(inner);\
            if (split >= 0) \{\
                char op = inner.charAt(split);\
                String left  = inner.substring(0, split).trim();\
                String right = inner.substring(split + 1).trim();\
                SymbolicEquation l = parseAxiom(left), r = parseAxiom(right);\
                if (op == '*') return new SymbolicEquation("(" + l.formula + " * " + r.formula + ")", v -> l.op.applyAsDouble(v) * r.op.applyAsDouble(v));\
                if (op == '+') return new SymbolicEquation("(" + l.formula + " + " + r.formula + ")", v -> l.op.applyAsDouble(v) + r.op.applyAsDouble(v));\
                if (op == '-') return new SymbolicEquation("(" + l.formula + " - " + r.formula + ")", v -> l.op.applyAsDouble(v) - r.op.applyAsDouble(v));\
            \}\
        \}\
        // Unary: sin(inner), cos(inner), tanh(inner)\
        if (f.startsWith("sin(") && f.endsWith(")")) \{ SymbolicEquation a = parseAxiom(f.substring(4, f.length() - 1)); return new SymbolicEquation("sin(" + a.formula + ")", v -> Math.sin(a.op.applyAsDouble(v))); \}\
        if (f.startsWith("cos(") && f.endsWith(")")) \{ SymbolicEquation a = parseAxiom(f.substring(4, f.length() - 1)); return new SymbolicEquation("cos(" + a.formula + ")", v -> Math.cos(a.op.applyAsDouble(v))); \}\
        if (f.startsWith("tanh(") && f.endsWith(")")) \{ SymbolicEquation a = parseAxiom(f.substring(5, f.length() - 1)); return new SymbolicEquation("tanh(" + a.formula + ")", v -> Math.tanh(a.op.applyAsDouble(v))); \}\
        // Unknown \'97 fall back to tanh but mark it\
        return new SymbolicEquation(f + " [rebuilt
\f5 \uc0\u8594 
\f3 tanh]", Math::tanh);\
    \}\
\
    /** Find the top-level binary operator split in an expression (skip nested parens). */\
    private int findBinaryOpSplit(String s) \{\
        int depth = 0;\
        for (int i = s.length() - 1; i >= 0; i--) \{\
            char c = s.charAt(i);\
            if (c == ')') depth++;\
            else if (c == '(') depth--;\
            else if (depth == 0 && (c == '*' || c == '+' || c == '-') && i > 0) return i;\
        \}\
        return -1;\
    \}\
\
    // ==========================================\
